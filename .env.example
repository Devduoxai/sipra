# Database (PostgreSQL - Supabase)
DATABASE_URL="your_supabase_postgresql_url_here"

# Gmail API (Email) - https://console.cloud.google.com
GMAIL_CLIENT_ID="your_client_id"
GMAIL_CLIENT_SECRET="your_client_secret"
GMAIL_REFRESH_TOKEN="your_refresh_token"
GMAIL_SENDER_EMAIL="your_gmail@gmail.com"

# Gemini AI (Message Generation) - Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Admin Key (for admin dashboard)
ADMIN_KEY="your_admin_key_here"

# Cron Secret (for Vercel Cron Job authentication)
CRON_SECRET="your_cron_secret_here"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
